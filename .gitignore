# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Aera build artifacts
zbrowser-desktop/dist/
zbrowser-desktop/node_modules/
tool-results/

# Browser build artifacts & large binaries
download/*.exe
download/archive/
upload/
backups-VERSIONS.md

# NOTE: the self-signed dev code-signing key (build/signing/*.key.pem,
# build/codesign/*.pfx, pass.txt) is deliberately COMMITTED — sandbox resets
# wiped untracked keys twice; losing the signing identity is worse than the
# low secrecy stakes of a local self-signed certificate.
